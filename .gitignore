# ── Maven ───────────────────────────────────────────────────
target/
*/target/
*.war
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.class
spring-boot-backend/.mvn/wrapper/maven-wrapper.jar
!spring-boot-backend/.mvn/wrapper/maven-wrapper.properties

# ── Python ──────────────────────────────────────────────────
fastapi-service/__pycache__/
fastapi-service/**/__pycache__/
fastapi-service/*.pyc
fastapi-service/venv/
fastapi-service/.venv/
fastapi-service/ml_models/*.pkl
fastapi-service/.pytest_cache/

# ── IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
.project
.classpath
.settings/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Uploads (user data — keep the folders, ignore the files) ─
spring-boot-backend/uploads/**
!spring-boot-backend/uploads/
!spring-boot-backend/uploads/*/
!spring-boot-backend/uploads/**/.gitkeep

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── Secrets (never commit these) ────────────────────────────
*.env
.env.*
application-prod.properties
application-production.properties
